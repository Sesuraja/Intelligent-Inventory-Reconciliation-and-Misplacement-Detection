APP_ENV=development
APP_NAME=Inventory Intelligence

# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/inventory_db

# Security & Authentication
JWT_SECRET=replace_with_secure_production_secret_key_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API & Frontend Configuration
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:8000

# Fixed UHF RFID Reader Configuration
RFID_READER_HOST=192.168.1.100
RFID_READER_PORT=5084
RFID_READER_PROTOCOL=LLRP
RFID_READER_ID=READER_01

# RFID Observation & Feature Engineering
RFID_OBSERVATION_WINDOW_SECONDS=10

# AI Intelligence & Model Serialization
AI_MODEL_DIRECTORY=./ml/model_artifacts
LOG_LEVEL=INFO

