APP_ENV=development
APP_NAME=Inventory Intelligence

# PostgreSQL Database Connection (Internal docker uses postgresql+psycopg://...)
DATABASE_URL=postgresql+psycopg://app_user:change_me_secure_db_pass@localhost:5432/inventory_rfid
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_secure_db_pass
POSTGRES_DB=inventory_rfid

# Security & Authentication (Standardized on JWT_SECRET)
JWT_SECRET=replace_with_secure_production_secret_key_32bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_AUTH=false

# Operating Mode: SIMULATION | PHYSICAL | OFFLINE
OPERATING_MODE=SIMULATION

# API & Frontend Configuration
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:8000
CORS_ORIGINS=*

# Fixed UHF RFID Reader Configuration (LLRP Protocol)
RFID_READER_HOST=192.168.1.100
RFID_READER_PORT=5084
RFID_READER_PROTOCOL=LLRP
RFID_READER_ID=READER_01
RFID_CONNECT_TIMEOUT_SEC=3.0
RFID_RECONNECT_INTERVAL_SEC=5.0

# RFID Observation & Feature Engineering
RFID_OBSERVATION_WINDOW_SECONDS=10
COLLECTOR_POLL_INTERVAL_SEC=2.0
RSSI_MIN_THRESHOLD_DBM=-85.0
CROSS_READ_RSSI_DIFF_THRESHOLD=6.0

# AI Intelligence & Model Serialization
AI_MODEL_DIRECTORY=./ml/model_artifacts
LOG_LEVEL=INFO
